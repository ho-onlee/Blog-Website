# Copy to .env. Generate SIGNUP_CODE with:
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
SIGNUP_CODE=
SITE_NAME=website
FAVICON_URL=/favicon.svg
PUBLIC_URL=https://your-domain.example
WEB_PORT=8080
HOST_BACKUP_DIR=../blog-backups

# Local CPU model. Docker Compose overrides AI_BASE_URL with its private Ollama service.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_CHARS=20000
TRUST_PROXY=loopback,linklocal,uniquelocal

# Optional hosted providers. Keys are read only by the backend container.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local CPU model. Compose connects the API to the internal ai service.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_CHARS=20000

# Optional hosted providers. Keys stay server-side; never add them to frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash