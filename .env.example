# Copy to .env and set a private invitation code.
SIGNUP_CODE=
SITE_NAME=website
FAVICON_URL=/favicon.svg
DB_NAME=site.sqlite
PUBLIC_URL=https://your-domain.example
WEB_PORT=8080
HOST_BACKUP_DIR=../blog-backups
# Optional absolute paths on a mounted drive. Existing data must be copied first.
# DATA_HOST_PATH=/mnt/storage/website/data
# OLLAMA_HOST_PATH=/mnt/storage/website/ollama

# Local CPU model. Compose connects the API to the internal ai service.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_CHARS=20000

# Optional hosted providers. Keys stay server-side; never add them to frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-lite